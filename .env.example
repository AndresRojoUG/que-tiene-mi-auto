# Supabase
# Create your project at https://supabase.com
# Leave every value blank in this file. Create a local .env.local file when the
# database provider is configured; it is ignored by Git and must never be shared.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only credential. Never prefix this variable with NEXT_PUBLIC and never
# place its value in client-side code, screenshots, commits, or messages.
SUPABASE_SERVICE_ROLE_KEY=
