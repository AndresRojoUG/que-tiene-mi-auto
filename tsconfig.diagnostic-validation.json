{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": ".diagnostic-validation",
    "rootDir": ".",
    "incremental": false
  },
  "include": [
    "data/diagnostics/**/*.ts",
    "data/technical/**/*.ts",
    "data/vehicles.ts",
    "data/vehicles.validate.ts",
    "scripts/validate-diagnostics.ts",
    "scripts/validate-technical-data.ts",
    "scripts/validate-vehicle-catalog.ts",
    "scripts/test-diagnostic-engine.ts"
  ]
}
